# MongoDB Atlas connection string (BetterAuth user/session storage)
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/bazardor
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# Local: http://localhost:3000 | Production: your deployed URL
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
